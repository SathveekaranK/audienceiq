# Copy this file to backend/.env and fill in what you need.
# backend/.env is git-ignored, so keys never end up in the repository.

# --- Database -------------------------------------------------------------
# Leave unset to use the local SQLite file (backend/audienceiq.db).
# DATABASE_URL=postgresql://localhost/audienceiq

# --- YouTube --------------------------------------------------------------
# Optional. The app works without any key by using YouTube's public
# InnerTube endpoints. Supplying a key only adds quota / reliability.
#
# YouTube Data API key (metadata, higher quota):
# YOUTUBE_API_KEY=

# InnerTube key (comments). Any valid Google API key works:
# INNERTUBE_API_KEY=

# SQL_ECHO=false
